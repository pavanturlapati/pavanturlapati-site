---
const links = [
  { label: "Animation", href: "/hobbies/animation/" },
  { label: "Chess", href: "/hobbies/chess/" },
  { label: "Movies", href: "/hobbies/movies/" },
];
---

<nav aria-label="Hobbies" class="hobbies-nav">
  <ul>
    {links.map(({ label, href }) => (
      <li><a href={href} aria-current={Astro.url.pathname === href ? "page" : Astro.url.pathname.startsWith(href) ? "location" : undefined}>{label}</a></li>
    ))}
  </ul>
</nav>

<style>
  .hobbies-nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    list-style: none;
    padding: 0;
    margin: 0 0 1.75rem;
    font-family: system-ui, sans-serif;
    font-size: 0.95rem;
  }
  a[aria-current] {
    font-weight: 700;
    text-decoration-thickness: 2px;
  }
</style>
