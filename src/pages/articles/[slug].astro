---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getArticles } from "../../lib/content";
import { formatDate } from "../../lib/format";

export async function getStaticPaths() {
  const articles = await getArticles();
  return articles.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { title, description, date, tags, linkedin, image } = entry.data;
---

<Base
  title={title}
  description={description}
  type="article"
  published={date.toISOString()}
  image={image}
>
  <p class="back"><a href="/articles/">← All articles</a></p>
  <article>
    <header>
      <h1>{title}</h1>
      <p class="meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {
          tags.map((tag) => (
            <>
              {" · "}
              <a href={`/articles/tag/${tag}/`}>{tag}</a>
            </>
          ))
        }
      </p>
    </header>
    {image && <img src={image} alt={title} width="1200" height="630" style="width:100%;height:auto;border-radius:8px;margin:0 0 1.5rem" />}
    <div class="prose">
      <Content />
    </div>
    {
      linkedin && (
        <p class="meta">
          Also on <a href={linkedin} rel="noopener" target="_blank">LinkedIn</a>
          . Join the conversation there.
        </p>
      )
    }
  </article>
</Base>
