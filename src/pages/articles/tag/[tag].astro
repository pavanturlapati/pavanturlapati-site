---
import Base from "../../../layouts/Base.astro";
import { getArticles } from "../../../lib/content";
import { formatDate } from "../../../lib/format";

export async function getStaticPaths() {
  const articles = await getArticles();
  const tags = [...new Set(articles.flatMap((entry) => entry.data.tags))];
  return tags.map((tag) => ({
    params: { tag },
    props: {
      tag,
      tagged: articles.filter((entry) => entry.data.tags.includes(tag)),
      allTags: tags.sort(),
    },
  }));
}

const { tag, tagged, allTags } = Astro.props;
---

<Base title={`Articles: ${tag}`} description={`Articles tagged ${tag}.`}>
  <h1>Articles</h1>
  <ul class="tag-list" aria-label="Filter by tag">
    <li><a href="/articles/">all</a></li>
    {
      allTags.map((t) => (
        <li>
          <a
            href={`/articles/tag/${t}/`}
            aria-current={t === tag ? "page" : undefined}
          >
            {t}
          </a>
        </li>
      ))
    }
  </ul>
  <ul class="entries">
    {
      tagged.map((entry) => (
        <li class="entry">
          <div class="meta">
            <time datetime={entry.data.date.toISOString()}>
              {formatDate(entry.data.date)}
            </time>
          </div>
          <h2>
            <a href={`/articles/${entry.id}/`}>{entry.data.title}</a>
          </h2>
          <p>{entry.data.description}</p>
        </li>
      ))
    }
  </ul>
</Base>
