---
import Base from "../../layouts/Base.astro";
import { getArticles } from "../../lib/content";
import { formatDate } from "../../lib/format";

const articles = await getArticles();
const usedTags = [...new Set(articles.flatMap((entry) => entry.data.tags))].sort();
---

<Base
  title="Blog"
  description="Blog posts on quality engineering, leadership, Vedanta and life."
>
  <h1>Blog</h1>
  <p class="lede">
    Longer pieces on quality engineering, leadership, Vedanta and life.
  </p>

  {
    usedTags.length > 0 && (
      <ul class="tag-list" aria-label="Filter by tag">
        {usedTags.map((tag) => (
          <li>
            <a href={`/blog/tag/${tag}/`}>{tag}</a>
          </li>
        ))}
      </ul>
    )
  }

  {
    articles.length === 0 ? (
      <p class="empty">No posts yet.</p>
    ) : (
      <ul class="entries">
        {articles.map((entry) => (
          <li class="entry">
            <div class="meta">
              <time datetime={entry.data.date.toISOString()}>
                {formatDate(entry.data.date)}
              </time>
              {entry.data.draft && <span class="badge">Draft</span>}
            </div>
            <h2>
              <a href={`/blog/${entry.id}/`}>{entry.data.title}</a>
            </h2>
            <p>{entry.data.description}</p>
          </li>
        ))}
      </ul>
    )
  }
</Base>
