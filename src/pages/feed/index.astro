---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { getLinks } from "../../lib/content";
import { formatDate } from "../../lib/format";

const links = await getLinks();
const rendered = await Promise.all(
  links.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
    hasComment: Boolean(entry.body?.trim()),
    host: new URL(entry.data.url).hostname.replace(/^www\./, ""),
  })),
);
---

<Base
  title="Feed"
  description="Articles and news worth reading, with a line on why."
>
  <h1>Feed</h1>
  <p class="lede">Articles and news worth reading, with a line on why.</p>

  {
    rendered.length === 0 ? (
      <p class="empty">Nothing here yet.</p>
    ) : (
      <ul class="entries">
        {rendered.map(({ entry, Content, hasComment, host }) => (
          <li class="entry">
            <div class="meta">
              <time datetime={entry.data.date.toISOString()}>
                {formatDate(entry.data.date)}
              </time>
              {" · "}
              {host}
              {entry.data.draft && <span class="badge">Draft</span>}
            </div>
            <h2>
              <a href={entry.data.url} rel="noopener" target="_blank">
                {entry.data.title}
              </a>
            </h2>
            {hasComment && (
              <div class="note-text prose">
                <Content />
              </div>
            )}
          </li>
        ))}
      </ul>
    )
  }
</Base>
