---
import Base from "../../layouts/Base.astro";
import { getChess, getFilms } from "../../lib/content";
import { formatDate, formatMonth, stars } from "../../lib/format";

const films = getFilms();
const chess = getChess();

const modes = (
  ["rapid", "blitz", "bullet", "daily"] as const
)
  .map((mode) => ({ mode, r: chess.ratings[mode] }))
  .filter((m) => m.r && m.r.win + m.r.loss + m.r.draw > 0);

const resultLabel = { win: "Won", loss: "Lost", draw: "Drew" } as const;

// Rapid rating chart, drawn as plain SVG at build time (no JavaScript).
const W = 600;
const H = 160;
const history = chess.rapidHistory;
const ratingsOnly = history.map((p) => p.rating);
const lo = Math.floor((Math.min(...ratingsOnly) - 20) / 50) * 50;
const hi = Math.ceil((Math.max(...ratingsOnly) + 20) / 50) * 50;
const t0 = new Date(history[0].date).getTime();
const t1 = new Date(history[history.length - 1].date).getTime();
const x = (date: string) =>
  ((new Date(date).getTime() - t0) / Math.max(t1 - t0, 1)) * W;
const y = (value: number) => H - ((value - lo) / (hi - lo)) * H;
const linePoints = history
  .map((p) => `${x(p.date).toFixed(1)},${y(p.rating).toFixed(1)}`)
  .join(" ");
const monthYear = (date: string) =>
  formatMonth(new Date(`${date}T00:00:00Z`));

// Oldest game first, so the strip reads left to right like a timeline.
const form = [...chess.games].reverse();
const recent = chess.games;
const recentWins = recent.filter((g) => g.result === "win").length;

const pct = (o: { win: number; games: number }) =>
  Math.round((o.win / o.games) * 100);
const openingsFor = (color: "white" | "black") =>
  chess.openings.filter((o) => o.color === color);

/** Watched date when known, otherwise the date it was logged. */
const dayOf = (film: (typeof films)[number]) =>
  film.watchedDate ?? film.publishedAt.slice(0, 10);

const sorted = [...films].sort(
  (a, b) =>
    dayOf(b).localeCompare(dayOf(a)) ||
    b.publishedAt.localeCompare(a.publishedAt),
);

// Group by month, preserving the sorted order.
const groups: { label: string; films: typeof films }[] = [];
for (const film of sorted) {
  const label = formatMonth(new Date(`${dayOf(film)}T00:00:00Z`));
  const last = groups[groups.length - 1];
  if (last && last.label === label) last.films.push(film);
  else groups.push({ label, films: [film] });
}
---

<Base
  title="Hobbies"
  description="Things I do for fun: chess and the films I watch."
>
  <h1>Hobbies</h1>
  <p class="lede">Things I do for fun, away from work.</p>

  <h2>Chess</h2>
  <p class="lede">
    I'm learning chess. Live from{" "}
    <a href={chess.profileUrl} rel="me noopener" target="_blank"
      >Chess.com</a
    >.
  </p>

  <ul class="chess-ratings">
    {
      modes.map(({ mode, r }) => (
        <li>
          <span class="chess-mode">{mode}</span>
          <strong>{r!.rating}</strong>
          <span class="meta">
            {r!.win}W {r!.loss}L {r!.draw}D
          </span>
          {r!.best !== null && <span class="meta">best {r!.best}</span>}
        </li>
      ))
    }
  </ul>

  <p class="meta">
    {chess.totalGames.toLocaleString("en-US")} games played since {
      monthYear(chess.joinedAt.slice(0, 10))
    }. Puzzle rating peaked at {chess.tactics}, a different scale from game
    ratings.
  </p>

  <h3>Rapid rating over time</h3>
  <figure class="chess-chart">
    <svg
      viewBox={`0 0 ${W} ${H}`}
      preserveAspectRatio="none"
      role="img"
      aria-label={`Rapid rating from ${ratingsOnly[0]} in ${monthYear(history[0].date)} to ${ratingsOnly[ratingsOnly.length - 1]} now`}
    >
      {
        [lo, (lo + hi) / 2, hi].map((v) => (
          <line
            x1="0"
            x2={W}
            y1={y(v)}
            y2={y(v)}
            class="chess-grid"
            vector-effect="non-scaling-stroke"
          />
        ))
      }
      <polyline
        points={linePoints}
        class="chess-line"
        vector-effect="non-scaling-stroke"
      />
    </svg>
    <figcaption class="chess-axis meta">
      <span>{monthYear(history[0].date)} · {lo}–{hi}</span>
      <span>{monthYear(history[history.length - 1].date)}</span>
    </figcaption>
  </figure>

  <h3>Last {form.length} games</h3>
  <p class="meta">
    Won {recentWins} of the last {recent.length}. Oldest on the left; each
    square opens the game on Chess.com.
  </p>
  <div class="chess-form">
    {
      form.map((game) => (
        <a
          href={game.url}
          rel="noopener"
          target="_blank"
          class={`chess-${game.result}-bg`}
          title={`${resultLabel[game.result]} as ${game.color} vs ${game.opponent} (${game.opponentRating}), ${game.timeClass}, ${formatDate(new Date(game.endedAt))}`}
          aria-label={`${resultLabel[game.result]} vs ${game.opponent}`}
        />
      ))
    }
  </div>

  <h3>Openings I play most</h3>
  <div class="chess-openings">
    {
      (["white", "black"] as const).map((color) => (
        <div>
          <h4 class="chess-mode">As {color}</h4>
          <table>
            <thead>
              <tr>
                <th>Opening</th>
                <th>Games</th>
                <th>Win %</th>
              </tr>
            </thead>
            <tbody>
              {openingsFor(color).map((o) => (
                <tr>
                  <td>{o.name}</td>
                  <td>{o.games}</td>
                  <td>{pct(o)}%</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ))
    }
  </div>

  <h2>Films</h2>
  <p class="lede">
    Films I've watched, straight from
    <a href="https://letterboxd.com/infi56/" rel="me noopener" target="_blank"
      >Letterboxd</a
    >. {films.length} logged so far.
  </p>

  {
    groups.length === 0 ? (
      <p class="empty">No films logged yet.</p>
    ) : (
      groups.map((group) => (
        <section>
          <h3>{group.label}</h3>
          <ul class="entries">
            {group.films.map((film) => (
              <li class="film">
                <div class="film-title">
                  <a href={film.url} rel="noopener" target="_blank">
                    {film.title}
                  </a>
                  {film.year && <span class="muted"> ({film.year})</span>}{" "}
                  {film.rating !== null && (
                    <span
                      class="film-rating"
                      aria-label={`${film.rating} out of 5`}
                    >
                      {stars(film.rating)}
                    </span>
                  )}
                  {film.liked && <span aria-label="liked"> ♥</span>}
                  {film.rewatch && <span class="badge">Rewatch</span>}
                  {film.watchedDate && (
                    <span class="meta">
                      {" "}
                      · {formatDate(new Date(`${film.watchedDate}T00:00:00Z`))}
                    </span>
                  )}
                </div>
                {film.review && <blockquote>{film.review}</blockquote>}
              </li>
            ))}
          </ul>
        </section>
      ))
    )
  }
</Base>
