---
import Base from "../../layouts/Base.astro";
import { getAnimation, getChess, getFilms } from "../../lib/content";

const episodes = await getAnimation();
const latestEpisode = episodes[0];
const chess = getChess();
const films = getFilms();
const latestFilm = [...films].sort((a, b) =>
  (b.watchedDate ?? b.publishedAt.slice(0, 10)).localeCompare(a.watchedDate ?? a.publishedAt.slice(0, 10)) ||
  b.publishedAt.localeCompare(a.publishedAt)
)[0];
---

<Base title="Hobbies" description="Things I do for fun: making animated stories, learning chess, and watching movies.">
  <h1>Hobbies</h1>
  <p class="lede">Things I do for fun, away from work.</p>
  <p>A place for the stories I make, the games I learn from, and the films I enjoy.</p>

  <div class="hobby-cards">
    <section class="animation-card">
      {latestEpisode && (
        <a href="/hobbies/animation/" aria-label="Explore my animations">
          <img src={latestEpisode.data.image} alt={latestEpisode.data.imageAlt} width="960" height="540" />
        </a>
      )}
      <div class="card-body">
        <h2><a href="/hobbies/animation/">Animation</a></h2>
        <p>Small animated stories, starting with Bobo and Little Star. I'm learning to bring ideas to life, one video at a time.</p>
        <p class="meta">{episodes.length} {episodes.length === 1 ? "story" : "stories"}{latestEpisode && ` · Latest: ${latestEpisode.data.title}`}</p>
        <a href="/hobbies/animation/">Watch the stories →</a>
      </div>
    </section>

    <section>
      <div class="card-body">
        <span class="hobby-symbol" aria-hidden="true">♞</span>
        <h2><a href="/hobbies/chess/">Chess</a></h2>
        <p>Learning through practice: my ratings, recent games, and the openings I play most.</p>
        <p class="meta">{chess.totalGames.toLocaleString("en-US")} games played{chess.ratings.rapid && ` · Rapid rating: ${chess.ratings.rapid.rating}`}</p>
        <a href="/hobbies/chess/">Follow my chess journey →</a>
      </div>
    </section>

    <section>
      <div class="card-body">
        <span class="hobby-symbol" aria-hidden="true">▶</span>
        <h2><a href="/hobbies/movies/">Movies</a></h2>
        <p>My film diary, with ratings and reviews from Letterboxd.</p>
        <p class="meta">{films.length} films logged{latestFilm && ` · Latest: ${latestFilm.title}`}</p>
        <a href="/hobbies/movies/">Browse the film diary →</a>
      </div>
    </section>
  </div>
</Base>

<style>
  .hobby-cards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.25rem; margin-top: 2rem; }
  section { border: 1px solid var(--line); border-radius: 8px; overflow: hidden; }
  .animation-card { grid-column: 1 / -1; }
  .card-body { padding: 1.25rem; }
  h2 { margin-top: 0; }
  img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; }
  .hobby-symbol { display: block; font: 2rem system-ui, sans-serif; color: var(--accent); margin-bottom: 0.75rem; }
  @media (max-width: 32rem) { .hobby-cards { grid-template-columns: 1fr; } }
</style>
